{
  "flow_name": "Actualizacion Articulos Proveedores",
  "description": "Flujo para actualizar precios y proveedores en el ERP Legacy",
  "input_file": "data/input/actualizar-art-pro.csv",
  "output_file": "data/output/resultados_actualizacion.csv",
  
  "pre_conditions": [
    {
      "action": "verify_anchor",
      "target": "erp_main_menu_loaded",
      "timeout_key": "medium_action"
    }
  ],
  
  "steps": [
    {
      "id": 1,
      "description": "Navegar a modulo de Articulos",
      "action_type": "click_image",
      "target_image": "apps/x2goclient_erp_legacy/assets/btn_modulo_articulos.png"
    },
    {
      "id": 2,
      "description": "Esperar que la pantalla de articulos cargue",
      "action_type": "wait_for_image",
      "target_image": "apps/x2goclient_erp_legacy/assets/titulo_pantalla_articulos.png",
      "timeout_key": "medium_action"
    },
    {
      "id": 3,
      "description": "Cargar el archivo CSV en memoria local (Inicia bucle de datos)",
      "action_type": "load_data",
      "target_file": "input_file"
    }
  ],
  
  "post_conditions": []
}